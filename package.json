{
  "name": "dev-focus-tracker",
  "publisher": "bytemate",
  "displayName": "Dev Focus Tracker",
  "description": "A productivity tracker for VS Code with a focus timer, Pomodoro sessions, daily goals, and productivity statistics.",
  "repository": {
    "type": "git",
    "url": "https://github.com/SonuSharma-creator/Dev-Focus-Tracker.git"
  },
  "icon": "media/icon.png",
  "version": "0.0.2",
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "contributes": {
    "commands": [
      {
        "command": "dev-focus-tracker.startTimer",
        "title": "Start Focus",
        "category": "Dev Focus Tracker"
      },
      {
        "command": "dev-focus-tracker.pauseTimer",
        "title": "Pause Focus",
        "category": "Dev Focus Tracker"
      },
      {
        "command": "dev-focus-tracker.resumeTimer",
        "title": "Resume Focus",
        "category": "Dev Focus Tracker"
      },
      {
        "command": "dev-focus-tracker.stopTimer",
        "title": "Stop Focus",
        "category": "Dev Focus Tracker"
      },
      {
        "command": "dev-focus-tracker.breakPause",
        "title": "Pause Break",
        "category": "Dev Focus Tracker"
      },
      {
        "command": "dev-focus-tracker.breakStop",
        "title": "Stop Break",
        "category": "Dev Focus Tracker"
      },
      {
        "command": "dev-focus-tracker.showDailyStats",
        "title": "Show Daily Stats",
        "category": "Dev Focus Tracker"
      },
      {
        "command": "dev-focus-tracker.openSettings",
        "title": "Open Settings",
        "category": "Dev Focus Tracker"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "dev-focus-tracker.startTimer",
          "when": "!devFocusTracker.isBreak && !devFocusTracker.isRunning && !devFocusTracker.isPaused"
        },
        {
          "command": "dev-focus-tracker.pauseTimer",
          "when": "devFocusTracker.isRunning && !devFocusTracker.isBreak"
        },
        {
          "command": "dev-focus-tracker.resumeTimer",
          "when": "devFocusTracker.isPaused"
        },
        {
          "command": "dev-focus-tracker.stopTimer",
          "when": "!devFocusTracker.isBreak && (devFocusTracker.isRunning || devFocusTracker.isPaused)"
        },
        {
          "command": "dev-focus-tracker.breakPause",
          "when": "devFocusTracker.isBreak"
        },
        {
          "command": "dev-focus-tracker.breakStop",
          "when": "devFocusTracker.isBreak"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "devFocusTracker",
          "title": "Dev Focus Tracker",
          "icon": "media/focus.svg"
        }
      ]
    },
    "views": {
      "devFocusTracker": [
        {
          "type": "webview",
          "id": "devFocusTracker.dailyStats",
          "name": "Daily Stats",
          "icon": "media/focus.svg"
        }
      ]
    },
    "configuration": {
      "title": "Dev Focus Tracker",
      "properties": {
        "dev-focus-tracker.focusDuration": {
          "type": "number",
          "default": 30,
          "minimum": 1,
          "maximum": 180,
          "description": "Focus session duration in minutes."
        },
        "dev-focus-tracker.breakDuration": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "maximum": 60,
          "description": "Break session duration in minutes."
        }
      }
    }
  },
  "scripts": {
    "lint": "eslint .",
    "pretest": "npm run lint",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.140.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "eslint": "^10.5.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}